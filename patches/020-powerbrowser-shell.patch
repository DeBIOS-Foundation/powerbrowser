diff --git a/browser/moz.build b/browser/moz.build
index 5a03cfc6d3..c242947294 100644
--- a/browser/moz.build
+++ b/browser/moz.build
@@ -27,6 +27,20 @@ DIRS += [
     "app",
 ]
 
+# D-89/D-92: powerbrowser/shell/ resolves through the upstream/powerbrowser
+# symlink to the repo's own powerbrowser/ tree -- our chrome code stays
+# entirely in powerbrowser/, never inside upstream/.
+#
+# D-20 (01-05): this DIRS entry is the WHOLE of 020-powerbrowser-shell.patch.
+# The patch used to carry a second hunk overriding the compiled
+# browser-chrome-URL define in browser/moz.configure so that the shell became
+# the startup window; startup-window selection now lives in
+# PowerBrowserSingleInstanceHandler (powerbrowser/shell/PowerBrowserAPI.sys.mjs)
+# instead, and that define keeps its stock upstream value. 020 is therefore a
+# hook-only patch: it adds a build directory and changes no upstream value,
+# which is the state Phase 5's brand-value strip (MIG-05) wants it in.
+DIRS += ["../powerbrowser/shell"]
+
 if CONFIG["MAKENSISU"]:
     DIRS += ["installer/windows"]
 
