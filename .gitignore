# Dependencies
node_modules/

# IN-09 (15-REVIEW.md): the root yarn.lock is a sidecar-build byproduct
# (empty header-only file, no root package.json to lock) -- never a shipped
# npm surface. Ignored so a future `git add -A` cannot silently convert it
# into one; the real lockfile lives under theia/.
/yarn.lock

# Theia / TypeScript build output
# Anchored under theia/ so this doesn't also swallow scripts/lib/, which is
# hand-written source (the shared BiDi driver), not build output.
theia/**/lib/
src-gen/
gen-webpack*.js
gen-esbuild*.mjs
esbuild.mjs
# 14.1-03: the app's esbuild.mjs is the one build seam theia build writes only
# when absent; it carries the better-sqlite3 external the backend bundle needs
# (see its header), so it is tracked.
!theia/applications/browser/esbuild.mjs
*.tsbuildinfo
.eslintcache

# Theia runtime
plugins/
.theia/

# Firefox fork build spill (D-01 containment)
upstream/
objdir/
objdir-release/
objdir-nplus1/
.mozbuild/

# Generator output (GEN-04, D-16)
# scripts/generate.mjs writes every derived build surface here. Nothing under
# this directory is ever committed -- the tracked hand-written files under
# powerbrowser/ remain what the build consumes (D-01), and generated/ exists
# only to be compared against them. Root-anchored so it cannot also swallow a
# directory named generated/ nested somewhere else in the tree.
# (D-16 into plan 03-01: the --with-branding overlay symlink
# powerbrowser/branding-generated, created by scripts/fetch-upstream.sh's
# ensure_branding_overlay, is ignored here for the same reason -- it points
# into generated/ and is setup state, not source.)
/generated/
/powerbrowser/branding-generated

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# SQLite runtime sidecars (WAL index + frames beside fixture copies)
*.sqlite-wal
*.sqlite-shm

# Secrets
.env
.env.*
!.env.example

# Nix build outputs / direnv state
result
result-*
.direnv/

# Editor
.idea
.DS_Store
*.sw?

# Per-machine Claude Code settings
.claude/settings.local.json

# Per-machine agent/editor tooling state
.vscode/
.gsd/
opencode.json
