mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/../${SOURCERER_OBJDIR:-objdir}
ac_add_options --enable-application=browser
ac_add_options --disable-updater
ac_add_options --without-wasm-sandboxed-libraries
ac_add_options --with-libclang-path="$LIBCLANG_PATH"
ac_add_options --with-app-basename=Sourcerer
ac_add_options --with-distribution-id=org.deocracy
ac_add_options --disable-crashreporter
ac_add_options --with-ccache=sccache
ac_add_options --with-branding=${SOURCERER_BRANDING:-sourcerer/branding/dev}
mk_add_options "export MOZ_APP_REMOTINGNAME=sourcerer"
