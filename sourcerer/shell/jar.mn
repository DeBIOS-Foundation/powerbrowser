#
# SHELL-01/D-89: registers the sourcerer chrome package as a new top-level
# package inside browser.jar (not a separate jar file -- avoids a third
# patch hunk against browser/installer/package-manifest.in). No web-
# accessible flag on the registration line below -- nothing on the web
# may reach chrome://sourcerer/.

browser.jar:
%  content sourcerer %content/sourcerer/
   content/sourcerer/sourcerer.xhtml         (sourcerer.xhtml)
   content/sourcerer/sourcerer.js            (sourcerer.js)
   content/sourcerer/sourcerer.css           (sourcerer.css)
   content/sourcerer/SourcererAPI.sys.mjs    (SourcererAPI.sys.mjs)
   content/sourcerer/TheiaService.sys.mjs    (TheiaService.sys.mjs)
