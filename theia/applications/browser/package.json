{
  "private": true,
  "name": "powerbrowser-theia-browser-app",
  "version": "1.74.1",
  "theia": {
    "backend": {
      "config": {
        "frontendConnectionTimeout": 3000
      }
    },
    "frontend": {
      "config": {
        "applicationName": "PowerBrowser",
        "powerbrowserPrivilegedJs": false,
        "powerbrowserTelemetry": {
          "level": "off",
          "endpoint": null
        },
        "preferences": {
          "security.workspace.trust.enabled": false
        },
        "defaultTheme": "dark",
        "powerbrowserBranding": {
          "welcomeText": null,
          "aboutText": null,
          "repoUrl": "https://powerbrowser.org",
          "markSvg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 128 128\"><defs><style>.a{fill:#1a1a1a;}@media (prefers-color-scheme: dark){.a{fill:#fff;}}</style></defs><path class=\"a\" d=\"M89.24 27.96A44 44 0 1 1 38.76 27.96L45.64 37.79A32 32 0 1 0 82.36 37.79Z\"/><rect class=\"a\" x=\"58\" y=\"18\" width=\"12\" height=\"46\" rx=\"6\"/></svg>",
          "legalNotices": [
            "Power Browser is a trademark of DeBIOS Foundation.",
            "PowerBrowser Dev is not officially associated with Mozilla or its products.",
            "This product (powerbrowser.org) includes Eclipse Theia, a trademark of Eclipse Foundation AISBL."
          ]
        }
      }
    }
  },
