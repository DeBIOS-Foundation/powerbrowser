{
  "private": true,
  "name": "powerbrowser-theia-browser-app",
  "version": "1.74.1",
  "theia": {
    "backend": {
      "config": {
        "frontendConnectionTimeout": 3000
      }
    },
    "frontend": {
      "config": {
        "applicationName": "Power Browser",
        "powerbrowserPrivilegedJs": false,
        "preferences": {
          "security.workspace.trust.enabled": false
        }
      }
    }
  },
  "dependencies": {
    "@powerbrowser/branding": "0.1.0",
    "@powerbrowser/customize": "0.1.0",
    "@powerbrowser/tab-uris": "0.1.0",
    "@powerbrowser/token-gate": "0.1.0",
    "@theia/ai-anthropic": "1.74.1",
    "@theia/ai-chat": "1.74.1",
    "@theia/ai-chat-ui": "1.74.1",
    "@theia/ai-code-completion": "1.74.1",
    "@theia/ai-core": "1.74.1",
    "@theia/ai-core-ui": "1.74.1",
    "@theia/ai-editor": "1.74.1",
    "@theia/ai-ide": "1.74.1",
    "@theia/ai-mcp": "1.74.1",
    "@theia/ai-mcp-ui": "1.74.1",
    "@theia/ai-openai": "1.74.1",
    "@theia/ai-terminal": "1.74.1",
    "@theia/application-package": "1.74.1",
    "@theia/bulk-edit": "1.74.1",
    "@theia/callhierarchy": "1.74.1",
    "@theia/console": "1.74.1",
    "@theia/core": "1.74.1",
    "@theia/debug": "1.74.1",
    "@theia/editor": "1.74.1",
    "@theia/editor-preview": "1.74.1",
    "@theia/file-search": "1.74.1",
    "@theia/filesystem": "1.74.1",
    "@theia/keymaps": "1.74.1",
    "@theia/markers": "1.74.1",
    "@theia/messages": "1.74.1",
    "@theia/monaco": "1.74.1",
    "@theia/monaco-editor-core": "1.108.201",
    "@theia/navigator": "1.74.1",
    "@theia/notebook": "1.74.1",
    "@theia/outline-view": "1.74.1",
    "@theia/output": "1.74.1",
    "@theia/ovsx-client": "1.74.1",
    "@theia/plugin": "1.74.1",
    "@theia/plugin-ext": "1.74.1",
    "@theia/plugin-ext-vscode": "1.74.1",
    "@theia/preferences": "1.74.1",
    "@theia/process": "1.74.1",
    "@theia/request": "1.74.1",
    "@theia/scm": "1.74.1",
    "@theia/search-in-workspace": "1.74.1",
    "@theia/task": "1.74.1",
    "@theia/terminal": "1.74.1",
    "@theia/test": "1.74.1",
    "@theia/timeline": "1.74.1",
    "@theia/typehierarchy": "1.74.1",
    "@theia/userstorage": "1.74.1",
    "@theia/variable-resolver": "1.74.1",
    "@theia/vsx-registry": "1.74.1",
    "@theia/workspace": "1.74.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@theia/cli": "1.74.1"
  },
  "scripts": {
    "rebuild": "theia rebuild:browser --cacheRoot ../..",
    "download:plugins": "theia download:plugins --packed",
    "build": "yarn -s rebuild && yarn -s download:plugins && theia build --app-target=browser --mode development",
    "start": "VSX_REGISTRY_URL=https://open-vsx.org THEIA_CONFIG_DIR=\"${XDG_CONFIG_HOME:-$HOME/.config}/powerbrowser\" bash -c 'mkdir -p \"$THEIA_CONFIG_DIR\" && theia start'"
  }
}
